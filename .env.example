# Kapyiŋi — configuration.
# Copy this file to .env (local) or paste the values in Vercel → Settings → Environment Variables.
# Never commit .env: it holds secrets.

# ── PayPal Sandbox (developer.paypal.com → Apps & Credentials → Sandbox) ──────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# E-mail of the Personal Sandbox account (the payer). It receives payment requests;
# `npm run demo:invoice` sends it a fictional bill.
PAYPAL_PAYER_EMAIL=

# ── Public address ────────────────────────────────────────────────────────────────
# Locally: http://localhost:3000. On Vercel: your production address, e.g. https://kapyini-xxx.vercel.app
# PayPal sends the payer back to this address, and passkeys (fingerprint) only work on it.
APP_URL=http://localhost:3000
PORT=3000
# Other addresses allowed for passkeys, comma-separated (optional).
EXTRA_ORIGINS=

# ── Payment rules ─────────────────────────────────────────────────────────────────
# The first currency is the default. Use your recipients' primary currency if captures come back as PENDING.
CURRENCIES=EUR,USD
# Maximum amount for a single payment.
LIMIT_PER_PAYMENT=200

# ── AI (optional) ─────────────────────────────────────────────────────────────────
# Claude understands free sentences. Without a key, built-in rules are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── Help (optional) ───────────────────────────────────────────────────────────────
# The person Kapyiŋi offers to call when the user asks for an advisor.
TRUSTED_NAME=
TRUSTED_PHONE=

# ── Deployment on Vercel ──────────────────────────────────────────────────────────
# Upstash Redis (free tier): required on Vercel, where memory is not shared between requests.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Contacts on one line, because data/contacts.json is not deployed (it is not committed).
CONTACTS_JSON=
