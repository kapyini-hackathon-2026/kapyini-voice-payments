{
  "name": "kapyini-voice-payments",
  "version": "1.1.0",
  "description": "KAPYIŊI — a voice-first, accessible assistant for PayPal payments (PayPal Sandbox, PayPal AI Hackathon 2026).",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "vite build --config web/vite.config.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "test": "node --test test/*.test.js",
    "demo:invoice": "node --env-file-if-exists=.env scripts/create-demo-invoice.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5"
  },
  "author": "Wahon Jean-Baptiste Ouattara and the Kapyiŋi team"
}
